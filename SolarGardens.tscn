[gd_scene load_steps=3 format=3]

[sub_resource type="GDScript" id="GDScript_camera"]
script/source = "extends Camera2D

## Movimento automático apenas para demonstrar o parallax.
## Depois essa câmera pode ser substituída pela câmera do Player.

@export var alcance: float = 350.0
@export var velocidade: float = 0.35

var tempo := 0.0

func _process(delta):
	tempo += delta
	position.x = sin(tempo * velocidade) * alcance
"

