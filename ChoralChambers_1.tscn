[gd_scene load_steps=3 format=3]

[sub_resource type="GDScript" id="GDScript_camera"]
script/source = "extends Camera2D
## Movimento automático só para você VER o parallax funcionando.
## Depois troca esse nó pela câmera do seu Player de verdade.

@export var alcance: float = 300.0
@export var velocidade: float = 0.4

var tempo := 0.0

func _process(delta):
	tempo += delta
	position.x = sin(tempo * velocidade) * alcance
"

